# Postgres (docker compose). Three roles, see ADR 0007.
DATABASE_URL_OWNER=postgresql://app_owner:app_owner@localhost:54329/psl
DATABASE_URL_WEB=postgresql://app_web:app_web@localhost:54329/psl
DATABASE_URL_SYSTEM=postgresql://app_system:app_system@localhost:54329/psl

# Plaid. Point PLAID_BASE_URL at the fake (http://localhost:4010) or https://sandbox.plaid.com (ADR 0008).
PLAID_BASE_URL=http://localhost:4010
PLAID_CLIENT_ID=
PLAID_SECRET=

# Master keyring, simulating a KMS (ADR 0006). Generate with: pnpm --filter @psl/crypto keygen
MASTER_KEYS={"1":"REPLACE_WITH_BASE64_32_BYTES"}
MASTER_KEY_CURRENT=1

# Session cookie signing key (ADR 0011).
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX

# Where Plaid sends webhooks for new Items (the Worker under `wrangler dev`).
# Against real Sandbox this must be a public URL (e.g. a tunnel to :8787).
PLAID_WEBHOOK_URL=http://127.0.0.1:8787/plaid/webhook
FAKE_PLAID_WEBHOOK_URL=http://127.0.0.1:8787/plaid/webhook
