{
  "name": "plaid-sync-ledger",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "pnpm --filter @psl/db migrate:deploy",
    "db:reset": "pnpm --filter @psl/db migrate:reset",
    "chaos": "pnpm --filter @psl/chaos chaos --",
    "rotate-master-key": "pnpm --filter @psl/ops rotate-master-key --"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
